# NextAuth
NEXTAUTH_URL=https://あなたのドメイン.vercel.app
NEXTAUTH_SECRET=ランダムな秘密鍵（openssl rand -base64 32 で生成）

# Google OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_ALLOWED_DOMAIN=会社のドメイン.com   # 例: example.co.jp

# Turso (本番SQLiteクラウド)
TURSO_DATABASE_URL=libsql://あなたのDB名-ユーザー名.turso.io
TURSO_AUTH_TOKEN=xxxxxxxx
